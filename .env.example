# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Server-only Supabase credentials (never expose to the browser).
# Use the service role key so Express can bypass RLS for privileged writes.
# Create these in the Supabase dashboard: Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend (also copy into frontend/.env)
VITE_API_BASE_URL=http://localhost:3000
