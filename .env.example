# Backend (Local development)
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Server-only Supabase credentials (never expose to the browser).
# Use the service role key so Express can bypass RLS for privileged writes.
# Create these in the Supabase dashboard: Project Settings → API.
# On Vercel: Set these under Project Settings → Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
# Local development: http://localhost:3000
# On Vercel (unified deployment): Automatically defaults to /api (no configuration needed)
# On Vercel (external backend): Set to your external backend URL (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=http://localhost:3000
